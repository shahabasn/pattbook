# ShopBook — Firebase Spark Free Plan Configuration
# Copy this file to .env and replace the values with your Firebase Project credentials:

VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-shop-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-shop-project
VITE_FIREBASE_STORAGE_BUCKET=your-shop-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
